# =====================================================================
# Living Faith Church International — Laderin-Hilltop
# Environment configuration
# =====================================================================
# Copy this file to `.env.local` and fill in the values for your project.
# NEVER commit `.env.local` — it is already listed in .gitignore.
# Every value below is a placeholder; no real secret belongs in this file.
# =====================================================================


# ---------------------------------------------------------------------
# Supabase — project URL and publishable (anon) key
# ---------------------------------------------------------------------
# These two values are safe to expose to the browser.
# Find them in your Supabase dashboard under Project Settings → API.
# The publishable key is sometimes called the "anon key" or "public key".
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"


# ---------------------------------------------------------------------
# Supabase — secret (service role) key
# ---------------------------------------------------------------------
# Server-side only. This key bypasses Row Level Security, so it must never
# reach the browser, a client bundle, a log or a public repository.
# Find it in your Supabase dashboard under Project Settings → API.
# Rotate it immediately if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY"


# ---------------------------------------------------------------------
# Cloudinary — image storage for passport photographs
# ---------------------------------------------------------------------
# The cloud name and API key are safe to expose to the browser; the API
# secret must remain server-side. The browser never receives the secret —
# it receives a short-lived, server-signed upload ticket instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# Folder within Cloudinary where member photographs are stored.
# Optional — defaults to "lfc-laderin/members".
CLOUDINARY_UPLOAD_FOLDER="lfc-laderin/members"


# ---------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------
# The public base URL of the deployed application. Used to build the
# authentication redirect links (password reset, email confirmation).
# In production this is your Vercel domain, e.g. https://lfc-laderin.vercel.app
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ---------------------------------------------------------------------
# Secure superadmin provisioning
# ---------------------------------------------------------------------
# These are read ONLY by `node scripts/bootstrap-admin.mjs` and are never
# read by the running application. Set them in your shell (or a temporary
# .env.local) when you provision the first administrator, then remove them.
#
# The password must be at least 12 characters and contain at least one
# letter and one number. The account is forced to change it at first
# sign-in, so this is a one-time bootstrap value, not a permanent secret.
BOOTSTRAP_ADMIN_EMAIL="superadmin@yourchurch.org"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE-ME-Use-A-Strong-Temporary-Password-123"
BOOTSTRAP_ADMIN_NAME="Superadmin"

# Optional: operational roles to assign to the first administrator.
# Comma-separated. These must already exist in the database.
BOOTSTRAP_ADMIN_ROLES="Resident Pastor"


# ---------------------------------------------------------------------
# Limits and abuse protection
# ---------------------------------------------------------------------
# Maximum accepted photograph size in bytes. Default 5 MB.
MAX_UPLOAD_BYTES="5242880"

# Public registration attempts allowed per IP address per hour.
PUBLIC_RATE_LIMIT_PER_HOUR="10"

# Upload-signature requests allowed per IP address per hour.
UPLOAD_RATE_LIMIT_PER_HOUR="20"
